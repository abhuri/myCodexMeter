<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\mycodex-meter.ico</ApplicationIcon>
    <AssemblyName>myCodex Meter</AssemblyName>
    <RootNamespace>MyCodexMeter.Windows</RootNamespace>
    <Version>1.1.0</Version>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyCodexMeter.Core\MyCodexMeter.Core.csproj" />
  </ItemGroup>
</Project>
